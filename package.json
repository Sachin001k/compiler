{
  "name": "practice-ide",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @practice-ide/desktop",
    "build": "npm run build -w @practice-ide/desktop",
    "typecheck": "npm run typecheck -w @practice-ide/desktop",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "@electron/rebuild@3.7.3": true,
    "better-sqlite3": false,
    "node-pty": false
  }
}
